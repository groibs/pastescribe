# PasteScribe — variáveis de ambiente
# NADA aqui é obrigatório para rodar local: os defaults usam providers
# fake/local (docs/ARCHITECTURE.md §Ambientes). Nunca commitar .env real.
# Validação: packages/config/src/env.ts — variável nova entra lá e aqui
# no mesmo PR, com grupo, sensibilidade e ambiente.

# ── APP ──────────────────────────────────────────────────────────────
# URL canônica (metadata/SEO). Local: default http://localhost:3000
# APP_URL=http://localhost:3000

# ── SUPABASE (a partir da Onda 2) ────────────────────────────────────
# URL + anon key não são segredo (protegidos por RLS): mesmo valor no
# browser e no servidor, por isso o prefixo NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [SEGREDO — só servidor/worker, jamais no client]
# SUPABASE_SERVICE_ROLE_KEY=

# ── AI (Onda 5; fake é o default absoluto) ───────────────────────────
# AI_PROVIDER=fake            # fake | openai
# [SEGREDO] chaves separadas free/paid — docs/AI_COST_MODEL.md
# OPENAI_FREE_API_KEY=
# OPENAI_PAID_API_KEY=

# ── STORAGE (Onda 4) ─────────────────────────────────────────────────
# local = filesystem (só dev — Vercel não tem disco persistente entre
# requests); s3 = qualquer backend S3-compatible (R2 em produção).
# STORAGE_PROVIDER=local      # local | s3
# [SEGREDO — só servidor, jamais no client] exigidas se STORAGE_PROVIDER=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── WORKER (Onda 4.2c; processamento fora da Vercel) ────────────────
# WORKER_AUTOSTART=false
# WORKER_ID=
# WORKER_POLL_INTERVAL_SECONDS=2
# WORKER_LEASE_SECONDS=300
# WORKER_HEARTBEAT_INTERVAL_SECONDS=30
# WORKER_JOB_TIMEOUT_SECONDS=900
# WORKER_FFPROBE_TIMEOUT_SECONDS=30
# WORKER_FFMPEG_TIMEOUT_SECONDS=120
# WORKER_MAX_INPUT_BYTES=2147483648
# WORKER_MAX_OUTPUT_BYTES=2147483648
# WORKER_MAX_DURATION_SECONDS=14400
# WORKER_MAX_MEMORY_BYTES=2147483648
# WORKER_MAX_CPU_SECONDS=600
# WORKER_TEMP_ROOT=/tmp/pastescribe-worker
# FFPROBE_BINARY=ffprobe
# FFMPEG_BINARY=ffmpeg

# ── BILLING (Onda 3/9) ───────────────────────────────────────────────
# BILLING_PROVIDER=fake       # fake | stripe_test

# ── FEATURE FLAGS (docs/FEATURE_FLAGS.md — opt-in estrito true/1) ───
# Todas nascem desligadas. Kill switches migram para o banco na Onda 2.
# FLAG_OPENAI_ENABLED=false
# FLAG_FREE_AI_ENABLED=false
# FLAG_LINK_INGESTION_ENABLED=false
# FLAG_UPLOAD_ENABLED=false
# FLAG_MAINTENANCE_MODE=false
